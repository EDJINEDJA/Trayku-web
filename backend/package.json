{
  "name": "traiku-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Traiku backend: modules, workflows, API routes, subscribers and jobs, on the Medusa architecture without e-commerce.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false framework/cli/index.ts develop",
    "start": "tsx framework/cli/index.ts start",
    "db:migrate": "tsx framework/cli/index.ts db:migrate",
    "db:generate": "tsx framework/cli/index.ts db:generate",
    "db:rollback": "tsx framework/cli/index.ts db:rollback",
    "user": "tsx framework/cli/index.ts user",
    "api-key": "tsx framework/cli/index.ts api-key",
    "exec": "tsx framework/cli/index.ts exec",
    "seed": "tsx framework/cli/index.ts exec ./src/scripts/seed.ts",
    "seed:more": "tsx framework/cli/index.ts exec ./src/scripts/seed-more.ts",
    "seed:test": "tsx framework/cli/index.ts exec ./src/scripts/seed-test.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "postinstall": "npm --prefix admin install --no-audit --no-fund",
    "db:backup": "docker exec traiku-backup bash /backup.sh once",
    "db:restore": "bash docker/restore.sh"
  },
  "dependencies": {
    "awilix": "^13.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3"
  }
}
