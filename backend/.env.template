# Copy to .env and replace every "change-me" (`openssl rand -hex 32`).

# Database: three roles (see ../docker-compose.yml).
POSTGRES_PASSWORD=change-me
TRAIKU_OWNER_PASSWORD=change-me
TRAIKU_APP_PASSWORD=change-me
# The server: rows only.
DATABASE_URL=postgres://traiku_app:change-me@localhost:5432/traiku
# db:migrate: owns the tables.
DATABASE_MIGRATION_URL=postgres://traiku_owner:change-me@localhost:5432/traiku
DATABASE_LOGGING=false

PORT=9000
BACKEND_URL=http://localhost:9000
# How many proxies sit in front of the server (nginx, Cloudflare…): 0 when it is reached directly.
# Wrong, the visitors' IP can be forged and the limits bypassed.
TRUST_PROXY=0

# Comma-separated origins allowed to call each part of the API.
APP_CORS=http://localhost:8081,http://localhost:3000
ADMIN_CORS=http://localhost:5173
AUTH_CORS=http://localhost:8081,http://localhost:3000,http://localhost:5173

JWT_SECRET=change-me
FILE_SECRET=change-me

# Face check: refuse when the Traikeur is more than 150 m from the pickup.
CHECK_PICKUP_LOCATION=false

# SMS go to every country. Against SMS pumping: premium ranges blocked (empty = Traiku's list, see
# framework/utils/phone.ts), at most OTP_MAX_PER_HOUR sign-in codes per hour in all, and
# OTP_MAX_PER_ZONE_PER_HOUR per zone of numbers outside the home ones.
SMS_BLOCKED_PREFIXES=
SMS_HOME_PREFIXES=+33
OTP_MAX_PER_HOUR=300
OTP_MAX_PER_ZONE_PER_HOUR=20

# SMS: without these, the messages are written in the server log (local provider).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Backups (backup container): every N hours, kept N days, in ./backups.
BACKUP_EVERY_HOURS=24
BACKUP_KEEP_DAYS=14

# Paiement, comme Medusa : test (bacs à sable Stripe et PayPal, plus le « paiement test » sans débit) ou live (argent réel).
PAYMENT_MODE=test
# Stripe : clés sk_test_… / sk_live_… (dashboard.stripe.com → Développeurs → Clés API).
# Webhook : https://<votre-backend>/hooks/payment/stripe, événements checkout.session.completed et checkout.session.expired.
STRIPE_TEST_API_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_API_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Virements aux Traikeurs, Stripe Connect (comptes Express) avec la même clé : activez Connect dans le dashboard.
# Webhook Connect (« événements des comptes connectés ») : https://<votre-backend>/hooks/payout/stripe, événement account.updated.
# Sans clé Stripe, en test, le fournisseur test : l'IBAN se saisit dans l'app et aucun argent ne circule.
STRIPE_TEST_CONNECT_WEBHOOK_SECRET=
STRIPE_LIVE_CONNECT_WEBHOOK_SECRET=
# PayPal : developer.paypal.com → Apps & Credentials (Sandbox pour le test, Live pour le réel).
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
