{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@traiku/framework": ["./framework/index.ts"],
      "@traiku/framework/*": ["./framework/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["framework", "src", "tests", "traiku-config.ts"],
  "exclude": ["admin"]
}
